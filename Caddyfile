# Steps A-D2 (since 2026-10-22): the services run on ECS; this Caddy on today's host still
# terminates TLS and proxies to them by their Cloud Map names. The container uses public DNS
# servers (compose `dns:`, for the DuckDNS challenge), so the upstreams ask the VPC resolver.
{
	email {$ACME_EMAIL}
	auto_https disable_redirects
}

catoptricgames.duckdns.org {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# Every write through the site needs the CATO admin password (user "cato"): schedule
	# edits, run now, pause, the test alert, the Steamworks login form, uploads and game
	# edits. Reads stay open. Matched before handle_path strips "/api", so the frontend's
	# "/api/api/..." requests are covered. The collector's jobs and agents call the API on
	# localhost:5039, not through Caddy; the API port is not open on the tailnet.
	# CATO_ADMIN_HASH (in .env, set by scripts/set-admin-password.sh) is the base64 of a
	# bcrypt hash. docker-compose.yml defaults it to the hash of a random string nobody
	# kept, so writes stay locked until a password is set.
	@admin_writes {
		not method GET HEAD OPTIONS
		path /api/*
	}
	basic_auth @admin_writes {
		cato {$CATO_ADMIN_HASH}
	}

	handle_path /api/* {
		reverse_proxy {
			dynamic a api.cato.internal 8080 {
				refresh 10s
				resolvers 172.31.0.2
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a frontend.cato.internal 80 {
				refresh 10s
				resolvers 172.31.0.2
			}
		}
	}
}

ogt.catoptricgames.duckdns.org {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# OGT API routes already carry the /api prefix, so no handle_path strip here.
	handle /api/* {
		reverse_proxy {
			dynamic a ogt-api.cato.internal 8080 {
				refresh 10s
				resolvers 172.31.0.2
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a ogt-frontend.cato.internal 80 {
				refresh 10s
				resolvers 172.31.0.2
			}
		}
	}
}
