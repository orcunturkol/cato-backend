# The Caddyfile of the ECS edge node (Step D3); Dockerfile.caddy copies it into the image.
# Today's host mounts ./Caddyfile over it, so the host does not use this file.
#
# Listener: no bind directive, so Caddy listens on :443 on every interface of the edge node
# (host network). Only WireGuard reaches it: cato-edge-sg opens only UDP 51820 (WireGuard), so
# the Elastic IP and the private IP drop all other inbound traffic; WireGuard traffic arrives on
# wg0 (10.99.0.1), behind the security group. Never add an inbound rule for 443 to cato-edge-sg.
#
# Who sees which site: Caddy checks the client address (edge-wireguard.sh sets the ranges and
# WireGuard binds each address to one device key). CATO: the admin range 10.99.0.0/24 and the web
# range 10.99.2.0/24. OGT: every WireGuard range (also the team, 10.99.1.0/24). Everyone else
# gets 403. The check sits first in a route block: at the top level Caddy runs respond after
# handle, so a catch-all handle would answer first.
#
# Upstreams: Cloud Map A records (*.cato.internal, TTL 10 s) through the VPC resolver (the
# node's /etc/resolv.conf; wg0's dnsmasq is only for the devices). Caddy looks the names up
# again every 10 s, so it follows task IP changes. Keep the names in step with local.namespace
# and aws_service_discovery_service in infra/phase2/network.tf.
{
	email {$ACME_EMAIL}
	auto_https disable_redirects
}

catoptricgames.duckdns.org {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# Admin and web devices; the team gets 403.
	@outsider not remote_ip 10.99.0.0/24 10.99.2.0/24

	route {
		respond @outsider 403

		# Every write through the site needs the CATO admin password (user "cato"): schedule
		# edits, run now, pause, the test alert, the Steamworks login form, uploads and game
		# edits. Reads stay open. Matched before handle_path strips "/api", so the frontend's
		# "/api/api/..." requests are covered. The agents call api.cato.internal:8080 directly,
		# not through Caddy.
		# CATO_ADMIN_HASH (ECS secret cato/caddy/admin-hash) is the base64 of a bcrypt hash, the
		# same value as on today's host. The task does not start until the secret has a value.
		@admin_writes {
			not method GET HEAD OPTIONS
			path /api/*
		}
		basic_auth @admin_writes {
			cato {$CATO_ADMIN_HASH}
		}

		handle_path /api/* {
			reverse_proxy {
				dynamic a api.cato.internal 8080 {
					refresh 10s
				}
			}
		}

		handle {
			reverse_proxy {
				dynamic a frontend.cato.internal 80 {
					refresh 10s
				}
			}
		}
	}
}

ogt.catoptricgames.duckdns.org {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# Every WireGuard range: admin, web and team devices.
	@outsider not remote_ip 10.99.0.0/16

	route {
		respond @outsider 403

		# OGT API routes already carry the /api prefix, so no handle_path strip here.
		handle /api/* {
			reverse_proxy {
				dynamic a ogt-api.cato.internal 8080 {
					refresh 10s
				}
			}
		}

		handle {
			reverse_proxy {
				dynamic a ogt-frontend.cato.internal 80 {
					refresh 10s
				}
			}
		}
	}
}
